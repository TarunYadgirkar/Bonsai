            "open": {
              "type": "number"
            },
            "merged": {
              "type": "number"
            },
            "abandoned": {
              "type": "number"
            },
            "availableTokens": {
              "type": "number"
            },
            "briefTokens": {
              "type": "number"
            },
            "prunedPct": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "branches",
            "open",
            "merged",
            "abandoned",
            "availableTokens",
            "briefTokens",
            "prunedPct"
          ],
          "additionalProperties": false
        }
      },
      "required": [
