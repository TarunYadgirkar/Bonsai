{
  "manifest_version": 3,
  "name": "Bonsai for Claude",
  "description": "Branch side questions off any Claude chat with a compiled minimal brief, auto-routed model + effort, and one-insight merge-back. Human-in-the-loop: you always press send.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "dist/sw.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Bonsai" }
}
