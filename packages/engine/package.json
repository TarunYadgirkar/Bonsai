{
  "name": "@bonsai/engine",
  "version": "0.1.0",
  "description": "Tree-structured conversation engine: path-based context compilation, model+effort routing, cherry-pick merge.",
  "license": "MIT",
  "author": "Tarun Yadgirkar",
  "homepage": "https://github.com/TarunYadgirkar/Bonsai/tree/main/packages/engine#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/TarunYadgirkar/Bonsai"
  },
  "keywords": [
    "llm",
    "conversation-tree",
    "context-compilation",
    "model-routing",
    "brief-compiler",
    "ai-chat",
    "branching"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "types": "./dist/index.d.ts"
  },
  "devDependencies": {
    "tsup": "^8"
  }
}
