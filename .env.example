# Copy to .env.local and fill. Never commit .env.local.
# Every service below is optional — missing vars trigger mock mode (see AGENTS.md).

# Live inference (lib/provider.ts). Set exactly one; none means the mock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Store persistence — Neon Postgres (lib/kv.ts). Unset means in-memory only.
# Use YOUR LANE'S Neon branch, never the production one.
DATABASE_URL=
