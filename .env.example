# Copy to .env.local and fill. Never commit .env.local.
# Every service below is optional — missing vars trigger mock mode (see AGENTS.md).

# Live inference (packages/engine/src/provider.ts). Set exactly one; none means the mock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Session cookie signing (lib/session.ts). Unset means unsigned cookies.
SESSION_SECRET=

# Store persistence — Neon Postgres (lib/store.ts). Unset means in-memory only.
# Use YOUR LANE'S Neon branch, never the production one.
DATABASE_URL=
