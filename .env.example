# Copy to .env.local and fill. Never commit .env.local.
# Every service below is optional — missing vars trigger mock mode (see AGENTS.md).

# Snowflake Cortex — model calls (lib/llm.ts)
# Account URL looks like https://<account-identifier>.snowflakecomputing.com
SNOWFLAKE_ACCOUNT_URL=
SNOWFLAKE_PAT=

# EverMind EverOS — durable memory (lib/memory.ts). Key from everos.evermind.ai
EVERMIND_API_KEY=
